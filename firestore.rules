rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && request.auth.token.role == r; }
    match /products/{id} { allow read: if resource.data.active == true || role('owner'); allow write: if role('owner'); }
    match /orders/{id} {
      allow create, update, delete: if false; // All lifecycle writes go through validated Functions.
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || role('owner') || role('printer'));
    }
    match /orders/{orderId}/events/{eventId} {
      allow read: if signedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid || role('owner') || role('printer'));
      allow write: if false; // Append-only audit events are created by trusted Functions.
    }
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /auditLog/{id} { allow read: if role('owner'); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

